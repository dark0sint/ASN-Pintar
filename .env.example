# ===== Database =====
POSTGRES_USER=asnpintar
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=asnpintar
DATABASE_URL=postgresql://asnpintar:change_me_strong_password@postgres:5432/asnpintar

# ===== Backend =====
PORT=4000
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# JP (Jam Pelajaran) target tahunan default untuk pegawai baru
DEFAULT_JP_TARGET=20

# ===== Jitsi (self-hosted) =====
# Domain server Jitsi Meet milik instansi (deploy terpisah, lihat README)
JITSI_DOMAIN=meet.instansi-anda.go.id
# Isi jika Jitsi diaktifkan dengan JWT auth (disarankan untuk produksi)
JITSI_APP_ID=
JITSI_APP_SECRET=

# ===== Frontend =====
VITE_API_BASE_URL=http://localhost:4000/api

# ===== Integrasi SIASN/SAPK BKN (opsional, butuh kredensial resmi BKN) =====
SIASN_API_BASE_URL=
SIASN_CLIENT_ID=
SIASN_CLIENT_SECRET=
